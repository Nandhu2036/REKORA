# REKORA Environment Configuration Example
# Copy this file to .env or configure in local.properties
# NEVER commit production keys or payment secrets into source control!

# Backend Base API URL (Dev mode defaults to Android emulator localhost 10.0.2.2:8080)
REKORA_API_BASE_URL="http://10.0.2.2:8080/api/"

# Development / Pilot Mode Flag (true enables local Room DB seed fallback and sandbox payments)
REKORA_DEV_MODE=true

# AI Provider Gateway (Handled server-side through a secure proxy)
# REKORA_AI_PROXY_ENDPOINT="https://api.rekora.internal/v1/ai/blueprint"

# Campus Pilot Identifier
CAMPUS_PILOT_ID="SJCE_CHENNAI_01"
CAMPUS_INSTITUTION_NAME="St. Joseph's College of Engineering"
