<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rekora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Rekora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B1B2B</item>
        <item name="postSplashScreenTheme">@style/Theme.Rekora</item>
    </style>
</resources>
